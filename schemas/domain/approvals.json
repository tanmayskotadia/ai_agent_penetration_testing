{
  "additionalProperties": false,
  "properties": {
    "action_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Action Digest",
      "type": "string"
    },
    "assessment_id": {
      "format": "uuid",
      "title": "Assessment Id",
      "type": "string"
    },
    "decision_id": {
      "format": "uuid",
      "title": "Decision Id",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_revision": {
      "minimum": 1,
      "title": "Scope Revision",
      "type": "integer"
    },
    "state": {
      "default": "requested",
      "enum": [
        "requested",
        "approved",
        "denied",
        "revoked",
        "consumed"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "assessment_id",
    "decision_id",
    "action_digest",
    "scope_revision",
    "expires_at"
  ],
  "title": "Approval",
  "type": "object"
}
