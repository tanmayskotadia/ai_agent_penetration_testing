{
  "additionalProperties": false,
  "properties": {
    "assessment_id": {
      "format": "uuid",
      "title": "Assessment Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "title": "Limitations",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Digest",
      "type": "string"
    },
    "source_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Source Ids",
      "type": "array"
    }
  },
  "required": [
    "assessment_id",
    "created_at",
    "source_digest",
    "source_ids"
  ],
  "title": "ReportSnapshot",
  "type": "object"
}
