{
  "additionalProperties": false,
  "properties": {
    "assessment_id": {
      "format": "uuid",
      "title": "Assessment Id",
      "type": "string"
    },
    "captured_at": {
      "format": "date-time",
      "title": "Captured At",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "pointer": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Pointer",
      "type": "string"
    },
    "pointer_type": {
      "enum": [
        "byte-range",
        "xml-path",
        "json-pointer",
        "whole-file"
      ],
      "title": "Pointer Type",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Sha256",
      "type": "string"
    }
  },
  "required": [
    "assessment_id",
    "run_id",
    "sha256",
    "pointer",
    "pointer_type",
    "captured_at"
  ],
  "title": "EvidenceReference",
  "type": "object"
}
