{
  "additionalProperties": false,
  "properties": {
    "assessment_id": {
      "format": "uuid",
      "title": "Assessment Id",
      "type": "string"
    },
    "asset_id": {
      "format": "uuid",
      "title": "Asset Id",
      "type": "string"
    },
    "confidence": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "confidence_method": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence Method"
    },
    "cve": {
      "anyOf": [
        {
          "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cve"
    },
    "cvss_score": {
      "anyOf": [
        {
          "maximum": 10,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cvss Score"
    },
    "cvss_vector": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cvss Vector"
    },
    "cvss_version": {
      "anyOf": [
        {
          "enum": [
            "2.0",
            "3.0",
            "3.1",
            "4.0"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cvss Version"
    },
    "cwe": {
      "anyOf": [
        {
          "pattern": "^CWE-[0-9]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cwe"
    },
    "evidence_id": {
      "format": "uuid",
      "title": "Evidence Id",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "information_kind": {
      "const": "observed-evidence",
      "default": "observed-evidence",
      "title": "Information Kind",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_key": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Source Key",
      "type": "string"
    },
    "source_severity": {
      "anyOf": [
        {
          "maxLength": 100,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Severity"
    },
    "title": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "validation_state": {
      "default": "suspected",
      "enum": [
        "suspected",
        "unknown"
      ],
      "title": "Validation State",
      "type": "string"
    }
  },
  "required": [
    "assessment_id",
    "asset_id",
    "run_id",
    "evidence_id",
    "source_key",
    "title",
    "observed_at"
  ],
  "title": "Observation",
  "type": "object"
}
