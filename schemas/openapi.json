{
  "components": {
    "schemas": {
      "ActionRequest": {
        "additionalProperties": false,
        "properties": {
          "destination_url": {
            "maxLength": 2500,
            "minLength": 1,
            "title": "Destination Url",
            "type": "string"
          },
          "evidence_ids": {
            "default": [],
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 50,
            "title": "Evidence Ids",
            "type": "array"
          },
          "expected_impact": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Expected Impact",
            "type": "string"
          },
          "max_runtime_seconds": {
            "maximum": 300.0,
            "minimum": 1.0,
            "title": "Max Runtime Seconds",
            "type": "integer"
          },
          "parameters": {
            "additionalProperties": {
              "type": "integer"
            },
            "maxProperties": 2,
            "propertyNames": {
              "enum": [
                "timeout_seconds",
                "max_redirects"
              ]
            },
            "title": "Parameters",
            "type": "object"
          },
          "plan_id": {
            "format": "uuid",
            "title": "Plan Id",
            "type": "string"
          },
          "plan_revision": {
            "maximum": 2147483647.0,
            "minimum": 1.0,
            "title": "Plan Revision",
            "type": "integer"
          },
          "policy_id": {
            "format": "uuid",
            "title": "Policy Id",
            "type": "string"
          },
          "profile": {
            "enum": [
              "discovery",
              "passive-web",
              "active-web",
              "controlled-validation"
            ],
            "title": "Profile",
            "type": "string"
          },
          "rollback_instructions": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Rollback Instructions",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "template": {
            "enum": [
              "nmap.connect.v1",
              "zap.passive.v1",
              "zap.active.v1",
              "metasploit.disabled"
            ],
            "title": "Template",
            "type": "string"
          },
          "tool": {
            "enum": [
              "Nmap",
              "Nessus",
              "Greenbone",
              "Nikto",
              "OWASP ZAP",
              "Burp Suite",
              "Metasploit",
              "OpenAPI"
            ],
            "title": "Tool",
            "type": "string"
          }
        },
        "required": [
          "policy_id",
          "plan_id",
          "plan_revision",
          "tool",
          "template",
          "profile",
          "destination_url",
          "expected_impact",
          "rollback_instructions",
          "max_runtime_seconds"
        ],
        "title": "ActionRequest",
        "type": "object"
      },
      "ApiError": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Request Id"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ApiError",
        "type": "object"
      },
      "ApprovalCreate": {
        "additionalProperties": false,
        "properties": {
          "action_digest": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Action Digest",
            "type": "string"
          },
          "plan_id": {
            "format": "uuid",
            "title": "Plan Id",
            "type": "string"
          },
          "plan_revision": {
            "minimum": 1.0,
            "title": "Plan Revision",
            "type": "integer"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "plan_id",
          "plan_revision",
          "action_digest"
        ],
        "title": "ApprovalCreate",
        "type": "object"
      },
      "ApprovalView": {
        "properties": {
          "action": {
            "$ref": "#/components/schemas/ActionRequest"
          },
          "action_digest": {
            "title": "Action Digest",
            "type": "string"
          },
          "allowed_decisions": {
            "items": {
              "enum": [
                "approve",
                "deny"
              ],
              "type": "string"
            },
            "title": "Allowed Decisions",
            "type": "array"
          },
          "assessment_id": {
            "format": "uuid",
            "title": "Assessment Id",
            "type": "string"
          },
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "created_by": {
            "title": "Created By",
            "type": "string"
          },
          "execution_enabled": {
            "const": false,
            "default": false,
            "title": "Execution Enabled",
            "type": "boolean"
          },
          "expired": {
            "title": "Expired",
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "parameter_hash": {
            "title": "Parameter Hash",
            "type": "string"
          },
          "policy_digest": {
            "title": "Policy Digest",
            "type": "string"
          },
          "reviewer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reviewer"
          },
          "scope_id": {
            "format": "uuid",
            "title": "Scope Id",
            "type": "string"
          },
          "scope_revision": {
            "title": "Scope Revision",
            "type": "integer"
          },
          "state": {
            "enum": [
              "pending-review",
              "approved",
              "denied",
              "revoked",
              "consumed"
            ],
            "title": "State",
            "type": "string"
          },
          "valid_until": {
            "title": "Valid Until",
            "type": "string"
          }
        },
        "required": [
          "id",
          "assessment_id",
          "action",
          "action_digest",
          "parameter_hash",
          "scope_id",
          "scope_revision",
          "policy_digest",
          "valid_until",
          "created_by",
          "created_at",
          "state",
          "reviewer",
          "expired",
          "allowed_decisions"
        ],
        "title": "ApprovalView",
        "type": "object"
      },
      "Assessment": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "owner_id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Owner Id",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "name",
          "owner_id",
          "created_at"
        ],
        "title": "Assessment",
        "type": "object"
      },
      "AssessmentCreate": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "AssessmentCreate",
        "type": "object"
      },
      "Asset": {
        "additionalProperties": false,
        "properties": {
          "assessment_id": {
            "format": "uuid",
            "title": "Assessment Id",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "identifier": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Identifier",
            "type": "string"
          },
          "kind": {
            "enum": [
              "host",
              "url",
              "application"
            ],
            "title": "Kind",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "assessment_id",
          "identifier",
          "kind"
        ],
        "title": "Asset",
        "type": "object"
      },
      "AssetCreate": {
        "additionalProperties": false,
        "properties": {
          "identifier": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Identifier",
            "type": "string"
          },
          "kind": {
            "enum": [
              "host",
              "url",
              "application"
            ],
            "title": "Kind",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "identifier",
          "kind"
        ],
        "title": "AssetCreate",
        "type": "object"
      },
      "AuditEvent": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "pattern": "^[a-z][a-z0-9.-]{0,99}$",
            "title": "Action",
            "type": "string"
          },
          "action_digest": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Action Digest",
            "type": "string"
          },
          "actor_id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Actor Id",
            "type": "string"
          },
          "actor_kind": {
            "default": "human",
            "enum": [
              "human",
              "service",
              "ai-proposal"
            ],
            "title": "Actor Kind",
            "type": "string"
          },
          "assessment_id": {
            "format": "uuid",
            "title": "Assessment Id",
            "type": "string"
          },
          "correlation_id": {
            "format": "uuid",
            "title": "Correlation Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "event_id": {
            "format": "uuid",
            "title": "Event Id",
            "type": "string"
          },
          "outcome": {
            "enum": [
              "requested",
              "accepted",
              "denied",
              "pending",
              "completed",
              "partial",
              "failed",
              "unknown"
            ],
            "title": "Outcome",
            "type": "string"
          },
          "plan_revision": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Plan Revision"
          },
          "policy_version": {
            "default": "m02-v1",
            "maxLength": 100,
            "minLength": 1,
            "title": "Policy Version",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "resource_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Resource Id"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "scope_revision": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Scope Revision"
          }
        },
        "required": [
          "assessment_id",
          "actor_id",
          "correlation_id",
          "request_id",
          "action",
          "action_digest",
          "outcome"
        ],
        "title": "AuditEvent",
        "type": "object"
      },
      "Capability": {
