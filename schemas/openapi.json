            "items": {
              "type": "string"
            },
            "title": "Limitations",
            "type": "array"
          },
          "mode": {
            "default": "planned",
            "enum": [
              "live",
              "import-only",
              "planned",
              "unsupported"
            ],
            "title": "Mode",
            "type": "string"
          },
          "name": {
            "enum": [
              "Nmap",
              "Nessus",
              "Greenbone",
              "Nikto",
              "OWASP ZAP",
              "Burp Suite",
              "Metasploit",
              "OpenAPI"
            ],
            "title": "Name",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "status": {
            "default": "planned",
            "enum": [
              "live",
              "import-only",
              "planned",
              "unsupported"
            ],
            "title": "Status",
            "type": "string"
          },
          "supported_formats": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Supported Formats",
            "type": "array"
          }
        },
        "required": [
          "name"
