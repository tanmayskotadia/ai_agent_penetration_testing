            "type": "string"
          },
          "guarded_containers": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Guarded Containers",
            "type": "array"
          },
          "installed_edition": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
