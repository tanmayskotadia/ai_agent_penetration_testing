{
  "additionalProperties": false,
  "properties": {
    "action_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Action Digest",
      "type": "string"
    },
    "approval_id": {
      "format": "uuid",
      "title": "Approval Id",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "grant_reference": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Grant Reference",
      "type": "string"
    },
    "scope_id": {
      "format": "uuid",
      "title": "Scope Id",
      "type": "string"
    },
    "scope_revision": {
      "minimum": 1,
      "title": "Scope Revision",
      "type": "integer"
    }
  },
  "required": [
    "approval_id",
    "action_digest",
    "scope_id",
    "scope_revision",
    "expires_at",
    "grant_reference"
  ],
  "title": "ExecutionGrant",
  "type": "object"
}
