# Use python scripts/init_env.py; never commit the generated .env.
APP_SECRET=
BOOTSTRAP_TOKEN=
EVIDENCE_KEY=
EVIDENCE_KEY_ID=primary-v1
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://aegistrace:GENERATE_LOCALLY@127.0.0.1:5432/aegistrace
REDIS_URL=redis://127.0.0.1:6379/0
ENVIRONMENT=development
# External model calls remain disabled until the operator configures and approves a data policy.
ADAPTIVE_PLANNER_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=
MODEL_DATA_POLICY_REFERENCE=
MODEL_TIMEOUT_SECONDS=20
MODEL_MAX_COMPLETION_TOKENS=2048
MODEL_MAX_PLAN_REVISIONS=3
MODEL_MAX_ASSESSMENT_CALLS=20
